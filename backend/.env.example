# ── Database ─────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/clb_charity
DB_USER=postgres
DB_PASSWORD=postgres

# ── JWT ──────────────────────────────────────────────────
# Base64-encoded secret of at least 256 bits (32 bytes) for HS256.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=REPLACE_ME_WITH_A_BASE64_ENCODED_SECRET_AT_LEAST_32_BYTES_LONG==

# ── Cloudinary (image storage) ───────────────────────────
# Free account at https://cloudinary.com — copy these 3 values from the Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER=clb-media

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Social login (Google + Facebook), OPTIONAL ──────────────
# Leave disabled by default. To enable, activate the "oauth" profile AND fill the
# credentials below (register the OAuth apps in each provider's console first).
#   SPRING_PROFILES_ACTIVE=oauth
# Authorized redirect URI to register in BOTH consoles (dev):
#   Google:   http://localhost:5173/login/oauth2/code/google
#   Facebook: http://localhost:5173/login/oauth2/code/facebook
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# Where the backend sends the browser after social login (frontend routes):
# OAUTH2_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
# OAUTH2_FAILURE_REDIRECT=http://localhost:5173/auth/sign-in?error=oauth

# ── Monitoring dashboard (Render + Vercel), OPTIONAL ─────
# Leave blank to show "Chưa cấu hình" for these 2 cards — the Database and Cloudinary
# cards work without any of this, since they reuse the credentials above.
# Render: Account Settings → API Keys. Service id is the "srv-xxxx" in the service's URL.
RENDER_API_KEY=
RENDER_SERVICE_ID=
# Vercel: Account Settings → Tokens. Project id is in Project Settings → General.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

# ── Alert emails (Resend), OPTIONAL ──────────────────────
# Free account at https://resend.com — copy the API key. Leave blank to disable all
# alert emails (errors/over-80% will only show on the dashboard, no email sent).
RESEND_API_KEY=
# ALERT_EMAIL_TO=nguyenvana0258@gmail.com
# ALERT_EMAIL_FROM=onboarding@resend.dev
# DB_STORAGE_LIMIT_BYTES=524288000
# CLOUDINARY_STORAGE_LIMIT_BYTES=26843545600
